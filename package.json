{
  "name": "cactuspos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^22.13.0 || >=24.0.0", "npm": ">=10" },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @cactus/web",
    "start": "npm run build && npm run start --workspace @cactus/server",
    "seed": "npm run seed --workspace @cactus/server",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.2",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "concurrently": { "shell-quote": "^1.12.0" }
  }
}
