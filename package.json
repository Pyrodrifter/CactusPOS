{
  "name": "cactuspos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @cactus/web",
    "start": "npm run build && npm run start --workspace @cactus/server",
    "seed": "npm run seed --workspace @cactus/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.2"
  }
}
